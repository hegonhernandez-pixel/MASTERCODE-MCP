# .env.example - Copia esto a .env y completa con tus valores

# Gemini API Key (opcional para MVP - fallback a determinista)
# Obtener en: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=AQ.Ab8RN6Kp7M2sDvi6O229gYNc77oEOJCOAGjtpHfrxJBwwWHtgQ
# Server Express
PORT=3000
NODE_ENV=development

# GitHub Personal Access Token (para desplegar a repositorio)
# Obtener en: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Providers V2 (src/agents/providers.ts) ---------------------------

# Ollama local (agentes core)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ANALYTICAL=llama3.2:3b
OLLAMA_MODEL_SOLVER=gemma3:4b

# App Electron-LLM local (LM Studio, Jan.ai u otra con endpoint OpenAI-compatible)
ELECTRON_LLM_HOST=http://localhost:1234

# Modelos Gemini por rol
GEMINI_MODEL_CRITIC=gemini-2.5-flash
GEMINI_MODEL_SYNTHESIZER=gemini-2.5-pro

# GitHub Copilot API (token de Copilot, no el PAT de arriba)
GITHUB_COPILOT_TOKEN=
GITHUB_COPILOT_ENDPOINT=https://api.githubcopilot.com/chat/completions
COPILOT_MODEL_SOLVER=gpt-4o
